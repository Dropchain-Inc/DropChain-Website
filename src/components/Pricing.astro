---
import Icon from './Icon.astro';
import { plans, planFeatures } from '../data/site.js';
interface Props { heading?: string; sub?: string; }
const {
  heading = 'Choose your DropChain plan',
  sub = 'Pay by the month or year, and cancel at any time. All paid tiers have a 7 day free trial.',
} = Astro.props;
---
<section class="pricing dc-section" id="pricing">
  <div class="dc-container">
    <header class="pricing__head">
      <h2>{heading}</h2>
      <p class="dc-lead">{sub}</p>
    </header>

    <ul class="pricing__grid">
      {plans.map((plan) => (
        <li class:list={['plan', plan.featured && 'plan--featured']}>
          {plan.featured && <span class="plan__badge">Most Popular</span>}
          <h3 class="plan__name">{plan.name}</h3>
          <p class="plan__price">
            <span>{plan.price}</span>
            <small>{plan.cadence}</small>
          </p>
          {plan.note && <p class="plan__note">{plan.note}</p>}
          <a class:list={['plan__cta', plan.featured && 'plan__cta--solid']} href={plan.cta.href}>
            {plan.cta.label}
          </a>
          <ul class="plan__features">
            <li><Icon name="check" size={16} />{plan.calls}</li>
            <li><Icon name="check" size={16} />{plan.access}</li>
            {planFeatures.slice(1).map((feature) => (
              <li><Icon name="check" size={16} />{feature}</li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .pricing__head { text-align: center; max-width: 62ch; margin-inline: auto; margin-bottom: var(--dc-space-xl); }
  .pricing__head .dc-lead { margin-top: var(--dc-space-sm); }

  .pricing__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: var(--dc-space-md);
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: start;
  }
  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--dc-space-sm);
    padding: var(--dc-space-lg);
    background: var(--dc-surface);
    border: 1px solid var(--dc-border);
    border-radius: var(--dc-radius-lg);
  }
  .plan--featured { border-color: var(--dc-green); box-shadow: 0 0 0 1px var(--dc-green-fade), var(--dc-shadow); }
  .plan__badge {
    position: absolute;
    top: -0.75rem;
    left: var(--dc-space-lg);
    background-image: var(--dc-gradient);
    color: var(--dc-text-inverse);
    font-size: var(--dc-text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2rem 0.7rem;
    border-radius: var(--dc-radius-pill);
  }
  .plan__name { font-size: var(--dc-h4); }
  .plan__price { display: flex; align-items: baseline; gap: 0.4rem; }
  .plan__price span { font-size: 2.25rem; font-weight: 600; color: var(--dc-text); }
  .plan__price small { color: var(--dc-text-muted); font-size: var(--dc-text-sm); }
  .plan__note { color: var(--dc-text-muted); font-size: var(--dc-text-xs); }

  .plan__cta {
    display: block;
    text-align: center;
    padding: 0.7rem 1.25rem;
    margin-block: var(--dc-space-xs);
    border: 1px solid var(--dc-border);
    border-radius: var(--dc-radius-sm);
    color: var(--dc-text);
    font-size: var(--dc-text-sm);
    font-weight: 500;
    transition: border-color var(--dc-transition), color var(--dc-transition);
  }
  .plan__cta:hover { border-color: var(--dc-green); color: var(--dc-green); }
  .plan__cta--solid {
    background-image: var(--dc-gradient);
    border-color: transparent;
    color: var(--dc-text-inverse);
    box-shadow: var(--dc-glow);
  }
  .plan__cta--solid:hover { color: var(--dc-text-inverse); }

  .plan__features { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .plan__features li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    color: var(--dc-text-muted);
    font-size: var(--dc-text-sm);
    line-height: 1.5;
  }
  .plan__features :global(svg) { color: var(--dc-green); flex: none; margin-top: 0.2rem; }
</style>
