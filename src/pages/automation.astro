---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import Split from '../components/Split.astro';
import Testimonials from '../components/Testimonials.astro';
import Pricing from '../components/Pricing.astro';
import CtaBand from '../components/CtaBand.astro';
import { CONSOLE_URL } from '../data/navigation.js';

const steps = [
  { n: '1', title: 'Connect Your Contracts', blurb: 'Sync your NFT or token contracts so DropChain can start tracking on-chain activity.' },
  { n: '2', title: 'Define Key Triggers', blurb: 'Choose what actions to track, like mints, token sales, or staking events, to drive your campaigns.' },
  { n: '3', title: 'Launch Automations', blurb: 'Build and activate automated email flows based on wallet behavior, all from a no-code dashboard.' },
];

const gaps = [
  { icon: '/images/Link.svg', problem: "Disconnected Tools Don't Help", blurb: "You can't track wallet behavior or trigger messaging through Discord or Mailchimp.", answer: 'On-Chain Triggers' },
  { icon: '/images/User_8.svg', problem: "Unpersonalized Emails Won't Convert", blurb: 'With traditional CRMs, everyone gets the same message, regardless of their engagement.', answer: 'Behavioral Segmentation' },
  { icon: '/images/Vector_1.svg', problem: "Manual Follow Ups Don't Scale", blurb: 'You rely on manual work to keep up with activity, and people fall through the cracks.', answer: 'Automated Workflows' },
];

const campaigns = [
  'Reconnect when someone sells your token',
  'Welcome new holders with a drip series',
  'Reward loyal wallets that never sell',
  'Send reminders to inactive DAO voters',
  'Airdrop exclusive content after mint',
];
---

<BaseLayout
  title="Use Blockchain Data for Marketing"
  description="Automate your Web3 marketing with DropChain. Use on-chain wallet data to trigger smart campaigns, re-engage sellers, reward loyal holders, and scale your NFT or token community effortlessly."
>
  <PageHero
    eyebrow="For Web3 Community Managers"
    title="Automate Campaigns Using On-Chain Data"
    sub="Turn wallet activity into marketing that works. Re-engage token sellers, welcome new holders, and reward loyal users, all without lifting a finger. DropChain helps you act on real blockchain data."
  >
    <div class="actions"><Button href={CONSOLE_URL}>Get Started</Button></div>
    <img class="hero-image" src="/images/Screenshot-2025-03-30-at-1.58.53-PM.png" alt="" loading="lazy" />
  </PageHero>

  <Testimonials />

  <section class="dc-section">
    <div class="dc-container">
      <h2 class="section-head">How to Get Started with On-Chain Automation</h2>
      <ol class="steps">
        {steps.map((step) => (
          <li class="step">
            <span class="step__n">{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.blurb}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="dc-section--tight">
    <div class="dc-container">
      <header class="section-head">
        <h2>Stop Leaving Data and Engagement Behind</h2>
        <p class="dc-lead">
          Most Web3 teams are sitting on powerful wallet data, but have no way to use it
          to trigger campaigns or re-engage their community at the right time.
        </p>
      </header>
      <ul class="gaps">
        {gaps.map((item) => (
          <li>
            <img src={item.icon} alt="" loading="lazy" />
            <h3>{item.problem}</h3>
            <p>{item.blurb}</p>
            <p class="gaps__answer"><Icon name="check" size={16} />{item.answer}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Split
    heading="Marketing Is Changing in Web3"
    sub="Web3 projects generate an insane amount of useful data, like wallets, trades, mints and staking, but most of it goes unused. Without automation, you're stuck guessing who's active, who's drifting, and who deserves a reward. DropChain puts that data to work. Leverage on-chain data to scale your community, drive deeper engagement, and increase retention."
    image="/images/Newsletter-Image.png"
  >
    <div class="actions"><Button href={CONSOLE_URL}>Get Started</Button></div>
  </Split>

  <Split
    reverse
    tight
    heading="Smart Campaigns Triggered by Wallet Behavior"
    sub="Use automation to re-engage sellers, celebrate long-term holders, or guide new members through your ecosystem. Whether it's NFTs, tokens, or DAO activity, you can trigger targeted outreach based on real user actions."
    image="/images/ChatGPT-Image-Mar-30-2025-07_46_36-PM.png"
  >
    <ul class="campaigns">
      {campaigns.map((item) => <li><Icon name="check" size={16} />{item}</li>)}
    </ul>
    <div class="actions"><Button href={CONSOLE_URL}>Get Started</Button></div>
  </Split>

  <CtaBand
    heading="Start Automating Today"
    sub="On-chain marketing isn't the future, it's what your community expects now. DropChain makes it effortless to turn wallet behavior into engagement. No credit card required."
    cta="Get Started"
    href={CONSOLE_URL}
  />

  <Pricing />
</BaseLayout>

<style>
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: var(--dc-space-md); }
  .hero-image { margin-top: var(--dc-space-xl); border-radius: var(--dc-radius-lg); }
  .section-head { max-width: 64ch; margin-bottom: var(--dc-space-xl); }
  .section-head .dc-lead { margin-top: var(--dc-space-sm); }

  .steps, .gaps, .campaigns { list-style: none; margin: 0; padding: 0; }
  .steps, .gaps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--dc-space-md); }
  .step, .gaps li {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: var(--dc-space-lg);
    background: var(--dc-surface);
    border: 1px solid var(--dc-border);
    border-radius: var(--dc-radius);
  }
  .step__n {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background-image: var(--dc-gradient);
    color: var(--dc-text-inverse);
    font-size: var(--dc-text-sm);
    font-weight: 600;
  }
  .step h3, .gaps h3 { font-size: var(--dc-h5); }
  .step p, .gaps p { color: var(--dc-text-muted); font-size: var(--dc-text-sm); line-height: 1.65; }
  .gaps img { width: 30px; height: 30px; }
  .gaps__answer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--dc-green) !important;
    font-weight: 500;
  }

  .campaigns { display: grid; gap: 0.6rem; margin-top: var(--dc-space-sm); }
  .campaigns li { display: flex; align-items: flex-start; gap: 0.6rem; color: var(--dc-text-muted); font-size: var(--dc-text-sm); }
  .campaigns :global(svg) { color: var(--dc-green); flex: none; margin-top: 0.2rem; }

  @media (max-width: 900px) { .steps, .gaps { grid-template-columns: 1fr; } }
</style>
