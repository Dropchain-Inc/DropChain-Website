---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PostGrid from '../components/PostGrid.astro';
import CtaBand from '../components/CtaBand.astro';
import posts from '../data/posts/index.json';

const sorted = posts
  .filter((p) => p.category === 'Case Studies')
  .sort((a, b) => Date.parse(b.date) - Date.parse(a.date));
---

<BaseLayout title="Case Studies | DropChain" description="How teams are building and growing their communities with DropChain.">
  <PageHero eyebrow="Case Studies" title="Case Studies" sub="How teams are building and growing their communities with DropChain." />

  <section class="dc-section--tight">
    <div class="dc-container">
      <PostGrid posts={sorted} />
    </div>
  </section>

  <CtaBand />
</BaseLayout>
