---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import { DISCORD_URL } from '../../data/navigation.js';
---
<BaseLayout
  title="Cardano | DropChain"
  description="DropChain is coming to Cardano. Join the Discord to hear about it first."
>
  <section class="teaser">
    <div class="dc-container dc-container--narrow">
      <p class="dc-eyebrow">Cardano</p>
      <h1>We're coming to shake things up for Cardano...</h1>
      <p class="dc-lead">All good things come to those who wait.</p>
      <Button href={DISCORD_URL} icon="arrow">Join the Discord to hear first</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .teaser { padding-block: clamp(4rem, 12vw, 8rem); text-align: center; }
  .teaser h1 { margin-block: 0.6rem var(--dc-space-md); margin-inline: auto; }
  .teaser .dc-lead { margin-inline: auto; margin-bottom: var(--dc-space-lg); }
</style>
