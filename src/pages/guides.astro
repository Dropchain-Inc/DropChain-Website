---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PostGrid from '../components/PostGrid.astro';
import CtaBand from '../components/CtaBand.astro';
import posts from '../data/posts/index.json';

const sorted = posts
  .filter((p) => p.category === 'Guides')
  .sort((a, b) => Date.parse(b.date) - Date.parse(a.date));
---

<BaseLayout title="Guides | DropChain" description="Step-by-step walkthroughs for building with the DropChain API, SDKs and no-code tools.">
  <PageHero eyebrow="Guides" title="Guides" sub="Step-by-step walkthroughs for building with the DropChain API, SDKs and no-code tools." />

  <section class="dc-section--tight">
    <div class="dc-container">
      <PostGrid posts={sorted} />
    </div>
  </section>

  <CtaBand />
</BaseLayout>
