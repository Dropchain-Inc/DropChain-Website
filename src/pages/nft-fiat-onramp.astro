---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Split from '../components/Split.astro';
import LinkCards from '../components/LinkCards.astro';
import CtaBand from '../components/CtaBand.astro';
import { CONSOLE_URL, DOCS_URL } from '../data/navigation.js';

const FIAT_DOCS = 'https://dropchain.gitbook.io/dropchain-api-beta/dropchain-overview/fiat-onramp';

const features = [
  { title: 'Accept Credit Card Payments for NFTs on any Blockchain', blurb: 'NFT Checkout supports Algorand, Ethereum, Arbitrum, and more.', href: FIAT_DOCS, image: '/images/Frame-22_1.avif' },
  { title: 'Direct Deposit', blurb: 'Get your money via ACH bank transfer or any crypto listed on Coinbase.', href: FIAT_DOCS, image: '/images/Frame-31.svg' },
  { title: 'Automatic Wallets', blurb: 'Wallets are automatically created when users sign up to your platform.', href: '/sso', image: '/images/Frame-30.svg' },
  { title: 'No Gas Fees', blurb: "We'll take care of all the gas fees your users generate.", href: `${FIAT_DOCS}#overview`, image: '/images/Frame-33.svg' },
  { title: 'No KYC required', blurb: "Users don't need to go through a lengthy KYC identification process.", href: FIAT_DOCS, image: '/images/Frame-29-1.svg' },
];
---

<BaseLayout
  title="Sell NFTs & Credit Cards | DropChain"
  description="Use DropChain to let everyone buy your NFTs, not just people with a wallet. Let anyone with a credit card buy your NFT and other blockchain assets."
>
  <PageHero
    eyebrow="Onboard the Masses"
    title="Accept Credit Cards for your NFT Sales"
    sub="Allow anyone to buy your NFTs, even if they don't have a wallet."
  >
    <div class="hero-actions">
      <Button href={CONSOLE_URL}>Get Started - Free</Button>
      <Button href={DOCS_URL} variant="ghost" icon="arrow">Docs</Button>
    </div>
    <img class="hero-image" src="/images/Frame-172-1.avif" alt="" loading="lazy" />
  </PageHero>

  <Split
    heading="Make Buying Your NFTs Easy For Anyone with a Credit Card"
    sub="Buying NFTs is too complicated. Allow anyone with a Credit Card to buy, not just people with a crypto wallet."
    image="/images/Group-22_1.avif"
  >
    <h3 class="split-sub">Accept Credit Cards payments, sell NFTs to anyone</h3>
    <p class="dc-muted">
      Sell NFTs for credit card payments, eliminating extra fees and verification
      processes. Make buying NFTs easy with a streamlined payment process.
    </p>
    <div class="hero-actions">
      <Button href={CONSOLE_URL}>Quick Start</Button>
      <Button href={DOCS_URL} variant="ghost" icon="arrow">Learn More</Button>
    </div>
  </Split>

  <Split
    reverse
    tight
    eyebrow="It's complicated"
    heading="Buying an NFT is complex and takes forever"
    sub="Buying an NFT requires lots of upfront work, technical skill, and tons of time."
    image="/images/Frame-5-5.avif"
  >
    <div class="hero-actions">
      <Button href={CONSOLE_URL}>Quick Start</Button>
      <Button href={DOCS_URL} variant="ghost" icon="arrow">Learn More</Button>
    </div>
  </Split>

  <LinkCards
    heading="DropChain Makes Selling your NFTs Easy"
    sub="Explore our suite of features that makes DropChain the easiest platform for your users to buy your NFTs."
    items={features}
  />

  <LinkCards
    heading="Keep going"
    items={[
      { title: 'Bubble Integration', blurb: 'Add the DropChain API to a no-code Bubble app.', href: 'https://dropchain.gitbook.io/dropchain-api-beta/dropchain-examples/integrating-dropchain-api-into-no-code-bubble.io-app' },
      { title: 'Python SDK', blurb: 'Build web3 apps in Python without Solidity.', href: 'https://dropchain.gitbook.io/dropchain-api-beta/dropchain-overview/dropchain-sdk' },
    ]}
    columns={2}
  />

  <CtaBand heading="Start selling to everyone" sub="Free to start. No credit card required." href={CONSOLE_URL} />
</BaseLayout>

<style>
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: var(--dc-space-md); }
  .hero-image { margin-top: var(--dc-space-xl); border-radius: var(--dc-radius-lg); }
  .split-sub { font-size: var(--dc-h5); margin-top: var(--dc-space-sm); }
</style>
