---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Split from '../components/Split.astro';
import LinkCards from '../components/LinkCards.astro';
import CtaBand from '../components/CtaBand.astro';
import { CONSOLE_URL, DOCS_URL } from '../data/navigation.js';
import { fiatFeatures } from '../data/features.js';

const seamless = [
  { lordicon: 'rqqkvjqf', title: 'No KYC', blurb: 'No more lengthy KYC process. Let your users buy NFTs instantly.' },
  { lordicon: 'cjieiyzp', title: 'Credit Card', blurb: 'Accept credit card payments on all of your NFT sales.' },
  { lordicon: 'jjjmlddk', title: 'Wallets', blurb: 'Wallets auto generate for users upon NFT purchase.' },
];
---

<BaseLayout
  title="NFT Marketplace"
  description="Use DropChain to let everyone buy your NFTs, not just people with a wallet. Let anyone with a credit card buy your NFT and other blockchain assets."
>
  <PageHero
    eyebrow="NFT Marketplace"
    title="Sell NFTs on the Most Inclusive Marketplace"
    sub="Accept credit cards & crypto for your digital assets & collectibles. Let anyone join your game or community."
  >
    <div class="actions">
      <Button href={CONSOLE_URL}>Get Listed</Button>
      <Button href="https://marketplace.dropchain.network/" variant="ghost" icon="arrow">Shop Now</Button>
    </div>
    <img class="hero-image" src="/images/App-Store-3_1.avif" alt="" loading="lazy" />
  </PageHero>

  <LinkCards heading="Making a Seamless NFT Experience" items={seamless} />

  <Split
    tight
    heading="Make Buying Your NFTs Easy For Anyone with a Credit Card"
    sub="Buying NFTs is too complicated. Allow anyone with a Credit Card to buy, not just people with a crypto wallet."
    image="/images/Group-22_1.avif"
  >
    <p class="compare"><span>With DropChain</span> versus <span>Without DropChain</span></p>
    <h3 class="split-sub">Accept Credit Cards payments, sell NFTs to anyone</h3>
    <p class="dc-muted">
      Sell NFTs for credit card payments, eliminating extra fees and verification
      processes. Make buying NFTs easy with a streamlined payment process.
    </p>
    <div class="actions">
      <Button href={CONSOLE_URL}>Quick Start</Button>
      <Button href={DOCS_URL} variant="ghost" icon="arrow">Learn More</Button>
    </div>
  </Split>

  <Split
    reverse
    tight
    eyebrow="It's complicated"
    heading="Buying an NFT is complex and takes forever"
    sub="Buying an NFT requires lots of upfront work, technical skill, and tons of time."
    image="/images/Frame-5-5.avif"
  >
    <div class="actions">
      <Button href={CONSOLE_URL}>Quick Start</Button>
      <Button href={DOCS_URL} variant="ghost" icon="arrow">Learn More</Button>
    </div>
  </Split>

  <LinkCards
    heading="DropChain Makes Selling your NFTs Easy"
    sub="Explore our suite of features that makes DropChain the easiest platform for your users to buy your NFTs."
    items={fiatFeatures}
  />

  <CtaBand heading="Get listed on the marketplace" sub="Free to start. No credit card required." cta="Get Listed" href={CONSOLE_URL} />
</BaseLayout>

<style>
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: var(--dc-space-md); }
  .hero-image { margin-top: var(--dc-space-xl); border-radius: var(--dc-radius-lg); }
  .split-sub { font-size: var(--dc-h5); margin-top: var(--dc-space-sm); }
  .compare { color: var(--dc-text-dim); font-size: var(--dc-text-xs); text-transform: uppercase; letter-spacing: 0.06em; }
  .compare span { color: var(--dc-green); }
</style>
