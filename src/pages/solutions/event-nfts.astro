---
import SolutionPage from '../../components/SolutionPage.astro';
---
<SolutionPage
  title="Event Proof of Attendance NFTs"
  description="Build an unforgettable event experience with an NFT POAP. DropChain makes the experience for admins and your attendees seamless."
  eyebrow="Event Proof of Attendance NFTs"
  hero="Elevate your Event's Experience with NFTs"
  heroSub="Unlock unprecedented engagement and create lasting value for every event attendee."
  stepsHeading="How do DropChain NFTs work?"
  steps={[
    { icon: 'rdnltlpc', title: 'Mint', blurb: 'Create event NFTs to commemorate your event, organization, or community.', note: 'Just fill out a form' },
    { icon: 'ppsqwkvn', title: 'Drop', blurb: 'Attendees can claim their NFT by signing in with Google, Facebook, or Apple.', note: 'No wallet needed' },
    { icon: 'kndkiwmf', title: 'Connect', blurb: 'Create custom experiences for NFT holders to increase repeat attendance.', note: 'Custom holder experiences' },
  ]}
  useCasesHeading="Use Cases"
  useCasesSub="These are just a few of the ways you can leverage DropChain to create amazing customer experiences."
  useCases={[
    { title: 'Discounts', blurb: 'Allow your NFT holders to access discounts for events and other goods you sell.', image: '/images/markus-spiske-BTKF6G-O8fU-unsplash_1.avif' },
    { title: 'Exclusive Events', blurb: 'Create exclusive online or offline content to NFT holders.', image: '/images/dylan-gillis-KdeqA3aTnBY-unsplash_1.avif' },
    { title: 'Loyalty Programs', blurb: 'Give your closest community members a one-of-a-kind event experience.', image: '/images/hanny-naibaho-0YbeoQOX89k-unsplash_1.avif' },
    { title: 'Gated Content', blurb: 'Turn your community into customers for life with robust loyalty systems.', image: '/images/andras-vas-Bd7gNnWJBkU-unsplash_1.avif' },
  ]}
  build={{
    eyebrow: 'No Technical Knowledge Needed',
    heading: 'Create Event NFTs Effortlessly',
    body: "Building an NFT event experience doesn't have to be difficult. With DropChain, simply fill out a form to mint your NFT. Then, use the DropChain dashboard to create branded experiences and onboard your community.",
    image: '/images/656e8f8cf15d48f82316500c_Frame-1_1.avif',
  }}
  onboarding={{
    eyebrow: 'No Technical Knowledge Needed',
    heading: 'Easiest Blockchain Experience out there',
    body: "With DropChain Single Sign On, your community attendees can purchase or claim your NFT in seconds. No wallet or gas required. With support for Google, Facebook, or Apple sign in, it's so easy a caveman could do it.",
    image: '/images/Frame-2-1.avif',
  }}
/>
