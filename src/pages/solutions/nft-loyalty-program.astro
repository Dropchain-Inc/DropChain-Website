---
import SolutionPage from '../../components/SolutionPage.astro';
---
<SolutionPage
  title="NFT Loyalty Program"
  description="Build an unforgettable loyalty program with DropChain NFTs. DropChain makes the experience for admins and your customers seamless."
  eyebrow="NFT Loyalty Program"
  hero="Effortlessly Create an NFT Loyalty Program"
  heroSub="NFTs are the future of customer loyalty. DropChain makes user onboarding easier than ever."
  stepsHeading="How It Works"
  steps={[
    { icon: 'rdnltlpc', title: 'Mint', blurb: "Create custom NFTs for repeat customers. It's as easy as filling out a form.", note: 'Custom & simple' },
    { icon: 'ppsqwkvn', title: 'Onboard', blurb: 'Customers join your loyalty program. Sign up in one click with Facebook, Google, or Apple.', note: 'No wallet needed' },
    { icon: 'kndkiwmf', title: 'Grow', blurb: 'Create custom loyalty programs for new, existing, and VIP customers. Unlock a new source of revenue.', note: 'Custom programs' },
  ]}
  useCasesHeading="Who is DropChain Loyalty For?"
  useCasesSub="These are just a few of the ways you can leverage DropChain to create amazing customer loyalty experiences."
  useCases={[
    { title: 'Restaurants', blurb: 'Keep customers coming back with coupons, specials, and loyalty exclusives.', image: '/images/ivan-torres-MQUqbmszGGM-unsplash_1.avif' },
    { title: 'Event Organizers', blurb: 'Offer special discounts for future events to repeat attendees. Unlock a new source of revenue.', image: '/images/dylan-gillis-KdeqA3aTnBY-unsplash_1.avif' },
    { title: 'Content Creators', blurb: 'Create exclusive content for your most valued viewers, and charge for special access.', image: '/images/higor-hanschen-3Bz1yBpI3GI-unsplash_1.avif' },
    { title: 'Retail', blurb: 'Keep your customers coming back with sales and special offers.', image: '/images/tom-official-h0nYotrMIPU-unsplash_1.avif' },
  ]}
  build={{
    eyebrow: 'No Technical Knowledge Needed',
    heading: 'Simple Program Management',
    body: "Building an NFT loyalty program doesn't have to be difficult. With DropChain, simply fill out a form to mint your NFT and create your unique loyalty program.",
    image: '/images/Frame-4-1_1.avif',
  }}
  onboarding={{
    eyebrow: 'Easy user onboarding',
    heading: 'Simple Customer Onboarding',
    body: "With DropChain Single Sign On, your customers can sign up for your loyalty program in seconds. No wallet or gas required. With support for Google, Facebook, or Apple sign in, it's so easy a caveman could do it.",
    image: '/images/Frame-3-1.avif',
  }}
/>
